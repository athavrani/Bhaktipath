{
  "name": "bhaktipath",
  "version": "0.2.0",
  "private": true,
  "description": "Offline-first devotional chanting app for Android",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "generate:icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "build:android:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "sharp": "^0.34.5",
    "whisper.rn": "0.7.4",
    "react-native-safe-area-context": "~5.9.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  }
}